# Copy to .env.local and fill in. Never commit .env.local.

# Solana RPC the app and API routes use (devnet by default).
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Optional mainnet RPC, used when the network toggle is set to Mainnet.
# NEXT_PUBLIC_RPC_URL_MAINNET=

# Cluster the app points at by default: devnet | mainnet-beta | localnet
# NEXT_PUBLIC_CLUSTER=devnet

# Devnet faucet funder secret key (JSON array). Server-side only.
# HANKO_FAUCET_SECRET=[...]
# Minimum SOL the faucet keeps in reserve before it stops dripping.
# HANKO_FAUCET_RESERVE_SOL=0.5

# Tokens.xyz Assets API key for real OHLCV candlestick charts + quotes
# (server-side only, never expose to the browser). https://app.tokens.xyz
# Without it the app falls back to a coarse price line from the public feed.
# TOKENS_XYZ_API_KEY=

# Pyth Pro (Terminal) key for the live Pyth price on stock pages (server-side
# only). Free, self-serve at https://pythdata.app. Without it the stock page
# still names the on-chain Pyth settlement feed, just no live tick.
# PYTH_API_KEY=
